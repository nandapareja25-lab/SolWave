# =============================================================================
# D'ORATA — Variables de entorno (ejemplo; NUNCA pongas valores reales aquí)
# Local: copia a .dev.vars (Cloudflare) y .env.local (Next). Ambos están en .gitignore.
# Producción: secrets en Cloudflare →  npx wrangler secret put NOMBRE
# Regla: solo lo que empieza con NEXT_PUBLIC_ llega al navegador. Nada secreto ahí.
# =============================================================================

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://dorata18k.com
NEXT_PUBLIC_DEFAULT_LOCALE=es

# --- Supabase (nomenclatura nueva de claves) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # pública, protegida por RLS
SUPABASE_SECRET_KEY=                                      # SECRETA: solo servidor (webhook, checkout, cron)

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...            # pública
STRIPE_SECRET_KEY=                                        # SECRETA (sk_test_ en preview, sk_live_ en prod)
STRIPE_WEBHOOK_SECRET=                                    # SECRETA (whsec_...) — verifica la firma del webhook

# --- Cloudflare Turnstile (anti-bots) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=                                     # SECRETA

# --- Email transaccional (fase 5) ---
RESEND_API_KEY=                                           # SECRETA
EMAIL_FROM="D'ORATA <pedidos@dorata18k.com>"

# --- Seguridad / operación ---
ADMIN_ALLOWED_EMAILS=                                     # lista separada por comas (defensa extra al rol en BD)
SENTRY_DSN=                                               # fase 7
